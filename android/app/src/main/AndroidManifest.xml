<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No permissions are required by the release app:
        - Storage: file_picker + share_plus use the Storage Access Framework and
          the system share sheet, which need no storage permissions on modern
          Android (and never did for app-private files).
        - Internet: the app is local-first with no backend. url_launcher opens
          external https links in the user's browser, which does not require
          INTERNET in *this* app's manifest. INTERNET remains declared in the
          debug/profile source sets for the Flutter dev tooling.
    -->
    <!--
      url_launcher uses canLaunchUrl / the system browser to open https links.
      On Android 11+ (API 30) package visibility requires declaring the intent
      the app intends to resolve, otherwise canLaunchUrl returns false and the
      link silently does nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:label="Herbal Tracker+"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
