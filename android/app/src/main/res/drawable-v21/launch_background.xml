<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: the app's own dark scaffold colour.
     API 23+ selects this over drawable/launch_background.xml; keep it
     pinned to the same colour so system-light devices do not flash white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
